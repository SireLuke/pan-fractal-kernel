{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pan:abom-v8:mu-cube:0.1",
  "title": "ABOM-V8 μ-cube",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "cell_id", "state", "occupancy",
    "entropy_bits", "resonance", "scale", "recursion_level",
    "parent_id", "connections", "metadata"
  ],
  "properties": {
    "schema_version": { "const": "0.1" },
    "cell_id": { "type": "string", "minLength": 1 },
    "state": { "$ref": "urn:pan:abom-v8:state:0.1" },
    "occupancy": { "type": "number", "minimum": 0, "maximum": 1 },
    "entropy_bits": { "type": "number", "minimum": 0, "maximum": 1 },
    "resonance": { "type": "number", "minimum": 0, "maximum": 1 },
    "scale": { "type": "number", "exclusiveMinimum": 0 },
    "recursion_level": { "type": "integer", "minimum": 0 },
    "parent_id": { "type": ["string", "null"] },
    "connections": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "metadata": { "type": "object" }
  }
}
